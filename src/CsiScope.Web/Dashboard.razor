@page "/"
@inject SensingHostWorker Worker
@inject IAnomalySource AnomalySource
@implements IAsyncDisposable

<PageTitle>CsiScope — Sensing Dashboard</PageTitle>

@{ var snapshot = Worker.LatestSnapshot; }

<div class="container-fluid py-3">
    <h1 class="h4 mb-3 font-monospace">CsiScope <small class="text-muted">sensing campaign</small></h1>

    @if (snapshot is null)
    {
        <div class="d-flex align-items-center gap-2 text-secondary">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span>Awaiting telemetry…</span>
        </div>
    }
    else
    {
        @* Row 1 — campaign state + node liveness *@
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header py-1 font-monospace">Campaign</div>
                    <div class="card-body py-2">
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <span class="badge @ModeBadge(snapshot.Mode) fs-6">@snapshot.Mode</span>
                            <span>ch <strong>@(snapshot.LockedChannel is { } lc ? (int)lc : "—")</strong></span>
                            <span>target <code>@(snapshot.PrimaryTarget?.ToString() ?? "—")</code></span>
                            <span class="text-muted">in mode @((snapshot.TakenAt - snapshot.ModeEnteredAt).ToString(@"mm\:ss"))</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header py-1 font-monospace">Node Liveness (@snapshot.NodeLiveness.Length)</div>
                    <div class="card-body py-2">
                        <table class="table table-sm table-borderless mb-0 font-monospace">
                            <tbody>
                                @foreach (var n in snapshot.NodeLiveness)
                                {
                                    var stale = n.LastSeen is null || snapshot.TakenAt - n.LastSeen.Value > TimeSpan.FromSeconds(10);
                                    <tr>
                                        <td><code>@n.Node</code></td>
                                        <td class="@(stale ? "text-danger fw-bold" : "text-success")">
                                            @(n.LastSeen is { } seen ? $"{(snapshot.TakenAt - seen).TotalSeconds:F1}s ago" : "never seen")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        @* Row 2 — environment map + campaign history *@
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header py-1 font-monospace">Channel Activity</div>
                    <div class="card-body py-2">
                        @{ var maxActivity = GetMaxActivity(snapshot); }
                        <table class="table table-sm mb-0 font-monospace">
                            <thead><tr><th>Ch</th><th>Activity</th><th>Top MAC</th><th style="width:40%"></th></tr></thead>
                            <tbody>
                                @foreach (var c in snapshot.ChannelScores)
                                {
                                    var pct = maxActivity > 0 ? c.Activity.Value / maxActivity * 100 : 0;
                                    var isLocked = snapshot.LockedChannel is { } l && l == c.Channel;
                                    <tr>
                                        <td>
                                            @((int)c.Channel)
                                            @if (isLocked) { <span class="badge bg-success">lock</span> }
                                        </td>
                                        <td>@c.Activity.Value.ToString("F1")</td>
                                        <td><code>@c.TopMac</code></td>
                                        <td>
                                            <div style="background:#212529; height:10px;">
                                                <div style="width:@pct.ToString("F0")%; height:10px; background:#0d6efd;"></div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header py-1 font-monospace">Campaign History</div>
                    <div class="card-body py-2">
                        @if (snapshot.RecentEvents.Length == 0)
                        {
                            <span class="text-muted">No transitions since last snapshot.</span>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0 font-monospace small">
                                @foreach (var evt in snapshot.RecentEvents)
                                {
                                    <li>@DescribeEvent(evt)</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Row 3 — baselines + tripwire feed *@
        <div class="row g-3">
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-header py-1 font-monospace">Link Baselines (@snapshot.Baselines.Length)</div>
                    <div class="card-body py-2">
                        <table class="table table-sm mb-0 font-monospace">
                            <thead>
                                <tr><th>Node</th><th>Source</th><th>Ch</th><th style="width:25%">Fill</th><th>Mean</th><th>Floor</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var b in snapshot.Baselines)
                                {
                                    <tr>
                                        <td><code>@b.Link.Node</code></td>
                                        <td><code>@b.Link.Source</code></td>
                                        <td>@((int)b.Link.Channel)</td>
                                        <td>
                                            <div class="progress" style="height:10px;">
                                                <div class="progress-bar @(b.IsConverged ? "bg-success" : "bg-info")"
                                                     style="width:@(b.FillFraction * 100).ToString("F0")%"></div>
                                            </div>
                                        </td>
                                        <td>@b.Mean.ToString("F2")</td>
                                        <td>@b.CurrentFloor.Value.ToString("F4")</td>
                                        <td>
                                            @if (b.IsConverged) { <span class="badge bg-success">locked</span> }
                                            else { <span class="badge bg-secondary">filling</span> }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-header py-1 font-monospace">Tripwire Feed (@_recentAnomalies.Count)</div>
                    <div class="card-body py-2">
                        <table class="table table-sm mb-0 font-monospace">
                            <thead><tr><th>At</th><th>Link</th><th>Ratio</th><th>Amp</th><th>Floor</th></tr></thead>
                            <tbody>
                                @foreach (var a in _recentAnomalies)
                                {
                                    <tr>
                                        <td>@a.At.ToString("HH:mm:ss.fff")</td>
                                        <td><code>@a.Link.Node → @a.Link.Source</code></td>
                                        <td><span class="badge bg-danger">@a.DeviationRatio.Value.ToString("F1")×</span></td>
                                        <td>@a.RawAmplitude.ToString("F2")</td>
                                        <td>@a.CurrentFloor.ToString("F4")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const int MaxAnomalies = 50;

    private readonly List<AnomalyDetected> _recentAnomalies = new();
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private Task? _anomalyLoop;

    protected override void OnInitialized()
    {
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(333));
        _ = PollLoop();
        _anomalyLoop = ConsumeAnomaliesAsync(_cts.Token);
    }

    private static string ModeBadge(CampaignMode mode) => mode switch
    {
        CampaignMode.Surveying => "bg-warning text-dark",
        CampaignMode.Acquiring => "bg-info text-dark",
        CampaignMode.Detecting => "bg-success",
        _ => "bg-secondary",
    };

    private static double GetMaxActivity(SensingSnapshot snapshot)
    {
        var max = 0.0;
        foreach (var c in snapshot.ChannelScores)
        {
            if (c.Activity.Value > max) { max = c.Activity.Value; }
        }

        return max;
    }

    private static MarkupString DescribeEvent(object evt) => evt switch
    {
        ChannelLockAcquired e => new MarkupString(
            $"<span class='text-info'>LOCK</span> ch {(int)e.Channel} → <code>{e.PrimaryTarget}</code> <span class='text-muted'>{e.At:HH:mm:ss}</span>"),
        ConfidenceDegraded e => new MarkupString(
            $"<span class='text-warning'>DROP</span> ch {(int)e.Channel} — {e.Reason} <span class='text-muted'>(conf {e.Score.Value:F2}) {e.At:HH:mm:ss}</span>"),
        _ => new MarkupString($"<code>{evt}</code>"),
    };

    private async Task PollLoop()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts!.Token).ConfigureAwait(false))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (_cts!.IsCancellationRequested)
        {
            // component disposed
        }
    }

    private async Task ConsumeAnomaliesAsync(CancellationToken ct)
    {
        try
        {
            await foreach (var anomaly in AnomalySource.ReadAllAsync(ct).ConfigureAwait(false))
            {
                // Marshal onto the renderer's sync context — the channel
                // continuation runs on a threadpool thread.
                await InvokeAsync(() =>
                {
                    _recentAnomalies.Insert(0, anomaly);
                    if (_recentAnomalies.Count > MaxAnomalies)
                    {
                        _recentAnomalies.RemoveAt(_recentAnomalies.Count - 1);
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // component disposed
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        if (_anomalyLoop is not null)
        {
            try { await _anomalyLoop; } catch (OperationCanceledException) { }
        }

        _cts?.Dispose();
    }
}
