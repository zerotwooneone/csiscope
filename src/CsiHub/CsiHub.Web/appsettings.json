{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CsiIngestion": {
    "SerialPortNames": ["COM3","COM4","COM5"],
    "SerialBaudRate": 921600,
    "ReconnectDelayMs": 2000,
    "PayloadChannelCapacity": 1000,
    "StateChannelCapacity": 256,
    "CommandChannelCapacity": 32
  },
  "CsiAoaOptions": {
    "CarrierFrequencyHz": 2400000000,
    "SpeedOfLight": 300000000,
    "SourceCount": 1,
    "StepDegrees": 1,
    "SubcarrierIndex": 1,
    "SampleMaxAge": "00:00:02",
    "ConvergenceVarianceMultiplier": 1.5
  }
}
