    private static double GetRfBarWidth(RfChannelMetrics metrics, double maxPackets)
    {
        if (maxPackets <= 0 || metrics.Packets <= 0)
        {
            return 0.0;
        }

        return Math.Min(100.0, metrics.Packets * 100.0 / maxPackets);
    }

    private static double GetRfBarWidth(RfChannelAggregate aggregate, double maxPackets)
    {
        if (maxPackets <= 0 || aggregate.Packets <= 0)
        {
            return 0.0;
        }

        return Math.Min(100.0, aggregate.Packets * 100.0 / maxPackets);
    }

