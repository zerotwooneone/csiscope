@page "/"
@rendermode InteractiveServer
@using CsiHub.Features.Home.Services
@using CsiHub.Ingestion
@using CsiHub.Ingestion.Pipelines
@using Microsoft.JSInterop
@using System.Linq
@using System.Text.Json
@inject CsiNodeStateStore Store
@inject CsiNodePortManager PortManager
@inject CsiNodeConfigurationService ConfigService
@inject CsiDspBackgroundService Dsp
@inject HardwareConfigService Config
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Low-Level View</PageTitle>

<h3>Low-Level View</h3>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @_errorMessage
        <button type="button" class="btn-close" aria-label="Close" @onclick="() => _errorMessage = null"></button>
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
    <div class="d-flex gap-2 align-items-center">
        <label class="form-label mb-0">Scan depth</label>
        <select class="form-select form-select-sm" style="width: 11rem;" @bind="_sweepDwellMs">
            <option value="250">Quick (250 ms)</option>
            <option value="1000">Standard (1000 ms)</option>
            <option value="3000">Deep (3000 ms)</option>
        </select>
    </div>
    <div class="form-check form-check-inline mb-0">
        <input class="form-check-input" type="checkbox" id="accumulateSweep" @bind="_accumulateSweep">
        <label class="form-check-label" for="accumulateSweep">Accumulate across passes</label>
    </div>
    <button class="btn btn-primary" type="button" disabled="@Store.IsDistributedSweepActive" @onclick="StartDistributedRfScan">
        @(Store.IsDistributedSweepActive ? "Distributed RF Sweep Running..." : "Run Distributed RF Sweep")
    </button>
    <button class="btn btn-outline-primary" type="button" @onclick="ShowAggregateModal">View Aggregate RF Scan</button>
    <button class="btn btn-outline-secondary" type="button" @onclick="SendSyncTestToAll">Test Sync</button>
    <button class="btn btn-outline-secondary" type="button" @onclick="SendRfTestToAll">Test RF</button>
    @if (Store.IsDistributedSweepActive)
    {
        <button class="btn btn-outline-danger" type="button" @onclick="Store.StopDistributedSweep">Cancel Sweep</button>
    }
</div>

<table class="table">
    <thead>
        <tr>
            <th>COM Port</th>
            <th>MAC Address</th>
            <th>Connection Status</th>
            <th>Uptime</th>
            <th>Last Seen</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var node in Store.Nodes.Values)
        {
            <tr class="@(node.IsDisconnected ? "table-danger" : "")">
                <td>@node.PortName</td>
                <td>@(node.Mac ?? "-")</td>
                <td>
                    @node.State
                    @if (node.ActiveErrors.Count > 0)
                    {
                        <span class="badge bg-danger ms-2" data-bs-toggle="tooltip" data-bs-placement="top" title="@GetErrorsTooltip(node)">!</span>
                    }
                </td>
                <td>@(node.Uptime is not null ? TimeSpan.FromSeconds(node.Uptime.Value).ToString("hh\\:mm\\:ss") : "-")</td>
                <td>@(node.LastSeen is not null ? (DateTimeOffset.UtcNow - node.LastSeen.Value).ToString("hh\\:mm\\:ss") + " ago" : "-")</td>
                <td>
                    <div class="d-inline-flex flex-wrap gap-1">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Actions
                            </button>
                            <ul class="dropdown-menu">
                                <li><button class="dropdown-item" type="button" @onclick="() => SendSyncTest(node)">Sync Test</button></li>
                                <li><button class="dropdown-item" type="button" @onclick="() => SendRfScan(node)">Run RF Scan</button></li>
                                <li><button class="dropdown-item" type="button" @onclick="() => OpenRfModal(node)">RF Channel Override</button></li>
                                <li><button class="dropdown-item" type="button" @onclick="() => SendReboot(node)">Reboot</button></li>
                            </ul>
                        </div>

                        @{
                            var safeId = GetSafeId(node);
                        }

                        <div class="dropdown" data-bs-auto-close="outside">
                            <button class="btn btn-sm btn-info dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Hardware Features
                            </button>
                            <ul class="dropdown-menu p-3" style="min-width: 14rem;">
                                <li class="mb-2">
                                    <div class="form-check form-switch" @onclick:stopPropagation="true">
                                        <input class="form-check-input" type="checkbox" role="switch" id="clock-@safeId" checked="@IsClockLeader(node)" @onchange="(e) => ToggleClockLeader(node, e)">
                                        <label class="form-check-label" for="clock-@safeId">Clock Leader</label>
                                        <span class="badge @GetSyncRoleBadgeClass(node)" title="@GetSyncRoleReportedText(node)">@GetSyncRoleBadgeText(node)</span>
                                        @if (IsSyncRoleMismatch(node))
                                        {
                                            <span class="badge text-bg-warning ms-1" title="Configured role differs from the node's reported role">mismatch</span>
                                        }
                                    </div>
                                    @if (node.ActiveErrors.ContainsKey("clock_leader"))
                                    {
                                        <button class="btn btn-link text-danger p-0" type="button" @onclick="() => RetryClockLeader(node)">
                                            <span class="me-1">↻</span>Retry
                                        </button>
                                    }
                                </li>
                                <li class="mb-2">
                                    <div class="form-check form-switch" @onclick:stopPropagation="true">
                                        <input class="form-check-input" type="checkbox" role="switch" id="imu-@safeId" checked="@IsImuHost(node)" @onchange="(e) => ToggleImuHost(node, e)">
                                        <label class="form-check-label" for="imu-@safeId">IMU Host</label>
                                    </div>
                                    @if (node.ActiveErrors.ContainsKey("imu_host"))
                                    {
                                        <button class="btn btn-link text-danger p-0" type="button" @onclick="() => RetryImuHost(node)">
                                            <span class="me-1">↻</span>Retry
                                        </button>
                                    }
                                </li>
                            </ul>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (_selectedNode is not null)
{
    var safeId = GetSafeId(_selectedNode);
    var maxPackets = _selectedNode.RfScan.Count > 0 ? _selectedNode.RfScan.Values.Max(r => r.Packets) : 0.0;

    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" @onclick="CloseRfModal">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">RF Scan - @(_selectedNode.Mac ?? _selectedNode.PortName)</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseRfModal"></button>
                </div>
                <div class="modal-body">
                    @if (_selectedNode.RfScan.Count > 0)
                    {
                        <h6 class="mb-3">Channel Congestion</h6>
                        @foreach (var channel in _selectedNode.RfScan.Values.OrderBy(r => r.Channel))
                        {
                            <div class="d-flex align-items-center mb-2">
                                <div class="text-end me-2" style="width: 3rem;">Ch @channel.Channel</div>
                                <div class="progress flex-grow-1" style="height: 1.5rem;">
                                    <div class="progress-bar" role="progressbar" style="width: @(GetRfBarWidth(channel, maxPackets).ToString("F1"))%" title="RSSI min/max/avg: @channel.RssiMin / @channel.RssiMax / @channel.RssiAvg dBm, @channel.Errors errors">
                                    </div>
                                </div>
                                <div class="ms-2 text-muted" style="width: 7rem;">@channel.Packets pkts</div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No RF scan data available. Click <strong>Run RF Scan</strong> to collect channel metrics.</p>
                    }

                    <hr />

                    <div class="row g-3 align-items-center">
                        <div class="col-auto">
                            <label for="rf-channel-@safeId" class="col-form-label">Manual channel override</label>
                        </div>
                        <div class="col-auto">
                            <select id="rf-channel-@safeId" class="form-select" @bind="_manualChannel">
                                @for (int ch = 1; ch <= 13; ch++)
                                {
                                    <option value="@ch">@ch</option>
                                }
                            </select>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-primary" type="button" @onclick="SendSetRf">Set Channel</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" @onclick="CloseRfModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showAggregate)
{
    var maxPackets = Store.CombinedRfScan.Count > 0 ? Store.CombinedRfScan.Values.Max(r => r.Packets) : 0.0;

    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" @onclick="CloseAggregateModal">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Aggregate RF Scan (1-13)</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAggregateModal"></button>
                </div>
                <div class="modal-body">
                    @if (Store.LatestRecommendation is not null)
                    {
                        <div class="alert alert-info">
                            <strong>Recommendation:</strong> @Store.LatestRecommendation.Reason<br />
                            <small>Score: @Store.LatestRecommendation.Score.ToString("F2")</small>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary">Run a distributed RF sweep to generate a channel / MAC recommendation.</div>
                    }

                    @if (Store.CombinedRfScan.Count > 0)
                    {
                        <h6 class="mb-3">Combined Channel Congestion</h6>
                        @foreach (var channel in Store.CombinedRfScan.Values.OrderBy(r => r.Channel))
                        {
                            <div class="d-flex align-items-center mb-2">
                                <div class="text-end me-2" style="width: 3rem;">Ch @channel.Channel</div>
                                <div class="progress flex-grow-1" style="height: 1.5rem;">
                                    <div class="progress-bar" role="progressbar" style="width: @(GetRfBarWidth(channel, maxPackets).ToString("F1"))%" title="RSSI min/max/avg: @channel.RssiMin / @channel.RssiMax / @channel.RssiAvg dBm, @channel.Errors errors, @channel.SampleCount nodes">
                                    </div>
                                </div>
                                <div class="ms-2 text-muted" style="width: 7rem;">@channel.Packets pkts</div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No aggregate RF scan data available. Run a distributed RF sweep to collect a complete 1-13 channel map.</p>
                    }

                    <hr />

                    <h6 class="mb-3">Lock & Stream</h6>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Channel</label>
                            <select class="form-select" @bind="LockChannel">
                                @for (int ch = 1; ch <= 13; ch++)
                                {
                                    <option value="@ch">@ch</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Target MACs</label>
                            <div class="border rounded p-2" style="max-height: 10rem; overflow-y: auto;">
                                @if (Store.CombinedRfScan.TryGetValue(_lockChannel, out var selectedChannel) && selectedChannel is not null)
                                {
                                    @foreach (var mac in selectedChannel.TopMacs.Values.OrderByDescending(m => m.Packets).ThenByDescending(m => m.RssiAvg))
                                    {
                                        var macId = mac.Mac?.Replace(":", "-");
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="mac-@macId" checked="@_lockMacs.Contains(mac.Mac!)" @onchange="(e) => ToggleLockMac(mac.Mac, e)">
                                            <label class="form-check-label" for="mac-@macId" style="font-size: 0.875rem;">@mac.Mac (@mac.Packets pkts, @mac.RssiAvg.ToString("F1") dBm)</label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted mb-0">No MACs available for this channel.</p>
                                }
                            </div>
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button class="btn btn-outline-secondary w-100" type="button" @onclick="SelectTopMacs">Top 3</button>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">BW (MHz)</label>
                            <input type="number" class="form-control" @bind="_lockBw" min="20" max="40" step="20" />
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-success w-100" type="button" @onclick="LockAndStream">Lock & Stream</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" @onclick="CloseAggregateModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<h4 class="mt-4">Array Geometry</h4>
<div class="card mb-3">
    <div class="card-header">Node Geometry Configuration</div>
    <div class="card-body">
        <p class="text-muted small mb-2">
            Drag a node onto a mount. Dropping onto an occupied mount swaps them;
            drag a node back to the tray to unassign it.
        </p>
        <div class="d-flex flex-wrap gap-4 align-items-start">
            <div class="geom-board">
                <svg class="geom-arms" viewBox="0 0 160 160" aria-hidden="true">
                    <line x1="32" y1="128" x2="128" y2="128" />
                    <line x1="32" y1="128" x2="32" y2="32" />
                </svg>
                @foreach (var slot in GeometrySlots)
                {
                    var slotMac = GetSlotMac(slot.Id);
                    <div class="geom-slot @(slotMac is null ? "geom-slot-empty" : null) @(_dragOverSlot == slot.Id ? "geom-over" : null)"
                         style="left:@(slot.Left)px; top:@(slot.Top)px;"
                         data-geom-drop="true"
                         @ondragenter="() => _dragOverSlot = slot.Id"
                         @ondragleave="() => _dragOverSlot = null"
                         @ondrop="() => OnGeometryDrop(slot.Id)">
                        @if (slotMac is null)
                        {
                            <span class="geom-slot-label">@slot.Label</span>
                        }
                        else
                        {
                            @NodeChip(slotMac)
                            <span class="geom-slot-tag">@slot.Label</span>
                        }
                    </div>
                }
            </div>
            @{ var unassigned = GetUnassignedMacs().ToList(); }
            <div class="geom-tray @(_dragOverTray ? "geom-over" : null)"
                 data-geom-drop="true"
                 @ondragenter="() => _dragOverTray = true"
                 @ondragleave="() => _dragOverTray = false"
                 @ondrop="OnTrayDrop">
                <div class="geom-tray-title">Detected nodes</div>
                @if (unassigned.Count == 0)
                {
                    <div class="geom-tray-empty">No unassigned nodes</div>
                }
                @foreach (var mac in unassigned)
                {
                    @NodeChip(mac)
                }
            </div>
        </div>
        <div class="row g-3 mt-2">
            <div class="col-md-2">
                <label class="form-label">X spacing (m)</label>
                <input type="number" step="0.001" class="form-control" @bind="_geometry.XArmSpacingMeters" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Y spacing (m)</label>
                <input type="number" step="0.001" class="form-control" @bind="_geometry.YArmSpacingMeters" />
            </div>
        </div>
        <button class="btn btn-primary mt-3" @onclick="SaveGeometryAsync" disabled="@_geometrySaving">
            @(_geometrySaving ? "Saving..." : "Save Geometry")
        </button>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Target AoA Canvas</span>
        <span>
            <span class="badge bg-secondary" title="AoA pipeline status">@Dsp.LastAoaStatus</span>
            <span class="badge bg-secondary" title="Zero/live counts: configured subcarrier vs mid-band reference">@Dsp.SubcarrierDiag</span>
        </span>
    </div>
    <div class="card-body text-center" style="color: var(--bs-body-color)">
        <svg width="360" height="360" viewBox="0 0 360 360">
            <circle cx="180" cy="180" r="150" fill="none" stroke="currentColor" stroke-width="1" />
            <circle cx="180" cy="180" r="100" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="4 2" />
            <circle cx="180" cy="180" r="50" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2 2" />
            <line x1="180" y1="30" x2="180" y2="330" stroke="currentColor" stroke-width="1" />
            <line x1="30" y1="180" x2="330" y2="180" stroke="currentColor" stroke-width="1" />
            <circle cx="180" cy="180" r="4" fill="currentColor" />
            @* Static L-shaped antenna array in the world frame (no rotation until IMU
               integration). MUSIC measures azimuth from +Y, so the Y-arm points up
               (toward the top of the canvas) and the X-arm points right.
               Scale: 1 unit = 1 mm; arms are the 62.5 mm half-wavelength baseline. *@
            <g stroke="#4682B4" stroke-width="4" stroke-linecap="round">
                <title>Antenna array (62.5 mm baseline)</title>
                <line x1="180" y1="180" x2="242.5" y2="180" />
                <line x1="180" y1="180" x2="180" y2="117.5" />
            </g>
            <g fill="#4682B4" stroke="var(--bs-body-bg)" stroke-width="1.5">
                <circle cx="180" cy="180" r="6" />
                <circle cx="242.5" cy="180" r="6" />
                <circle cx="180" cy="117.5" r="6" />
            </g>
            @foreach (var t in GetTargetPlacements())
            {
                <line x1="180" y1="180" x2="@t.X" y2="@t.Y" stroke="@t.Color" stroke-width="2" />
                <circle cx="@t.X" cy="@t.Y" r="@t.Radius" fill="@t.Color" fill-opacity="0.7">
                    <title>@t.Mac</title>
                </circle>
            }
        </svg>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Raw Subcarrier Phase (per packet)</span>
        <span class="badge bg-secondary" title="Raw Atan2(Q,I) phase at the locked reference subcarrier, one point per packet. A flat line = stable phase (calibratable); uniform scatter across -pi..+pi = random per-packet offset (coherent AoA infeasible).">ref subcarrier @Dsp.ReferenceIndex</span>
    </div>
    <div class="card-body">
        @{ var phaseSeries = Dsp.GetPhaseSeries(); }
        @if (phaseSeries.Count == 0)
        {
            <p class="text-muted small mb-0">Collecting phase samples — the reference subcarrier locks after ~200 frames.</p>
        }
        else
        {
            <svg viewBox="0 0 720 220" width="100%" height="220" preserveAspectRatio="none" style="border:1px solid var(--bs-border-color); background:var(--bs-body-bg); color: var(--bs-body-color);">
                @* Horizontal gridlines at +pi, +pi/2, 0, -pi/2, -pi *@
                <line x1="34" y1="12"  x2="716" y2="12"  stroke="currentColor" stroke-width="0.5" stroke-dasharray="3 3" opacity="0.4" />
                <line x1="34" y1="61"  x2="716" y2="61"  stroke="currentColor" stroke-width="0.5" stroke-dasharray="3 3" opacity="0.4" />
                <line x1="34" y1="110" x2="716" y2="110" stroke="currentColor" stroke-width="0.8" opacity="0.6" />
                <line x1="34" y1="159" x2="716" y2="159" stroke="currentColor" stroke-width="0.5" stroke-dasharray="3 3" opacity="0.4" />
                <line x1="34" y1="208" x2="716" y2="208" stroke="currentColor" stroke-width="0.5" stroke-dasharray="3 3" opacity="0.4" />
                <text x="4" y="16"  font-size="10" fill="currentColor">+π</text>
                <text x="4" y="65"  font-size="10" fill="currentColor">+π/2</text>
                <text x="4" y="114" font-size="10" fill="currentColor">0</text>
                <text x="4" y="163" font-size="10" fill="currentColor">−π/2</text>
                <text x="4" y="212" font-size="10" fill="currentColor">−π</text>
                @for (int s = 0; s < phaseSeries.Count; s++)
                {
                    <polyline points="@PhasePoints(phaseSeries[s].Phases)" fill="none" stroke="@PhaseColor(s)" stroke-width="1.2" stroke-opacity="0.85" />
                }
            </svg>
            <div class="d-flex flex-wrap gap-3 mt-2 small">
                @for (int s = 0; s < phaseSeries.Count; s++)
                {
                    <span><span style="color:@PhaseColor(s)">&#9632;</span> @phaseSeries[s].NodeMac &larr; @phaseSeries[s].SrcMac</span>
                }
            </div>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>Hardware Diagnostics</span>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="SendSyncTestToAll">Test Sync (GPIO)</button>
                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="SendRfTestToAll">Test RF (Spectrum)</button>
            </div>
        </div>
    </div>
    <div class="card-body">
        <h6>STATE_DIAG_SYNC Telemetry</h6>
        @if (GetSyncDiagnostics().Count == 0)
        {
            <p class="text-muted small mb-3">No sync diagnostic data. Run Test Sync and wait for telemetry.</p>
        }
        else
        {
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Node MAC</th>
                        <th>Trigger Pulse Count</th>
                        <th>ISR Latency (μs)</th>
                        <th>Jitter (μs)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in GetSyncDiagnostics())
                    {
                        <tr>
                            <td>@row.Mac</td>
                            <td>@row.PulseCount</td>
                            <td>@row.LatencyUs.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</td>
                            <td>@row.JitterUs.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <h6 class="mt-3">STATE_DIAG_RF Telemetry</h6>
        @if (GetRfDiagnostics().Count == 0)
        {
            <p class="text-muted small mb-0">No RF diagnostic data. Run Test RF and wait for telemetry.</p>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>Node MAC</th>
                        <th>Channel</th>
                        <th>RSSI Min</th>
                        <th>RSSI Max</th>
                        <th>RSSI Avg</th>
                        <th>Packets</th>
                        <th>Errors</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in GetRfDiagnostics())
                    {
                        <tr>
                            <td>@row.Mac</td>
                            <td>@row.Channel</td>
                            <td>@row.RssiMin.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)</td>
                            <td>@row.RssiMax.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)</td>
                            <td>@row.RssiAvg.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)</td>
                            <td>@row.Packets</td>
                            <td>@row.Errors</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<h4 class="mt-4">Baseline Convergence</h4>
@if (Dsp.Baselines.Count == 0)
{
    <p class="text-muted">No baselines have been established yet. Run Lock & Stream to start learning.</p>
}
else
{
    @foreach (var group in GetBaselineDiagnostics()
        .GroupBy(d => d.SrcMac)
        .Where(g => g.Sum(d => d.FrameCount) >= 50)
        .OrderByDescending(g => g.Sum(d => d.FrameCount)))
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Target: @FormatMac(group.Key)</span>
                <span class="badge @GetWorstDropRateClass(group)">
                    Δ @group.Max(d => d.FrameDelta) frames (@group.Max(d => d.DropRate).ToString("P1"))
                </span>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    @foreach (var diag in group.OrderByDescending(d => d.FrameCount))
                    {
                        <div class="col-md-4" style="opacity: @GetOpacity(diag).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                            <h6>@diag.NodeMac</h6>
                            <div>@diag.FrameCount frames</div>
                            <div>Δ @diag.FrameDelta / @diag.DropRate.ToString("P1") drop</div>
                            <div>BW: @diag.Bandwidth MHz</div>
                            <div>Mean I/Q: @diag.MeanIq.ToString("F2")</div>
                            <div>P95 Var: @diag.PercentileVariance.ToString("F4")</div>
                            <div class="small text-muted">Last seen @GetLastSeenText(diag)</div>
                            <div>
                                <span class="badge @GetConvergenceClass(diag)">
                                    @(diag.IsConverged ? "Converged" : "Learning")
                                </span>
                                @if (diag.DropRate >= 0.10)
                                {
                                    <span class="badge bg-danger ms-1">Sync loss</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private PeriodicTimer? _timer;
    private string? _errorMessage;
    private NodeStateViewModel? _selectedNode;
    private bool _showAggregate;
    private int _manualChannel = 6;
    private int _lockChannel = 6;
    private int _lockBw = 20;
    private List<string> _lockMacs = new();
    private int _sweepDwellMs = 250;
    private bool _accumulateSweep;
    private readonly ConcurrentDictionary<string, byte> _cooldownKeys = new();
    private readonly ConcurrentDictionary<string, NodeConfiguration> _localConfigurations = new();
    private ArrayGeometryOptions _geometry = new();
    private bool _geometrySaving;

    private int LockChannel
    {
        get => _lockChannel;
        set
        {
            if (_lockChannel != value)
            {
                _lockChannel = value;
                UpdateLockMac();
            }
        }
    }

    private async Task UpdateLoop()
    {
        if (_timer is null)
        {
            return;
        }

        while (await _timer.WaitForNextTickAsync().ConfigureAwait(false))
        {
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _timer is null)
        {
            _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(333));
            _ = UpdateLoop();
            _geometry = await Config.LoadAsync();
            StateHasChanged();
        }

        await JS.InvokeVoidAsync("initTooltips");
    }

    private bool IsDisabled(string key)
    {
        return _cooldownKeys.ContainsKey(key);
    }

    private NodeConfiguration GetConfig(NodeStateViewModel node)
    {
        return _localConfigurations.GetOrAdd(node.Key, _ =>
        {
            var mac = node.Mac ?? node.Key;
            if (ConfigService.TryGetConfiguration(mac, out var existing) && existing is not null)
            {
                return new NodeConfiguration
                {
                    Mac = existing.Mac,
                    ClockLeader = existing.ClockLeader,
                    ImuHost = existing.ImuHost,
                };
            }

            return new NodeConfiguration { Mac = mac };
        });
    }

    private string GetSafeId(NodeStateViewModel node)
    {
        var mac = node.Mac ?? node.PortName ?? "unknown";
        return System.Text.RegularExpressions.Regex.Replace(mac, @"[^a-zA-Z0-9]", "-");
    }

    private bool IsClockLeader(NodeStateViewModel node) => GetConfig(node).ClockLeader == true;
    private bool IsImuHost(NodeStateViewModel node) => GetConfig(node).ImuHost == true;

    private async Task ToggleClockLeader(NodeStateViewModel node, ChangeEventArgs e)
    {
        var config = GetConfig(node);
        var newValue = e.Value is bool b && b;
        var previous = config.ClockLeader;
        config.ClockLeader = newValue;

        if (!await TryPushFeaturesAsync(node, config))
        {
            config.ClockLeader = previous;
        }
    }

    private async Task ToggleImuHost(NodeStateViewModel node, ChangeEventArgs e)
    {
        var config = GetConfig(node);
        var newValue = e.Value is bool b && b;
        var previous = config.ImuHost;
        config.ImuHost = newValue;

        if (!await TryPushFeaturesAsync(node, config))
        {
            config.ImuHost = previous;
        }
    }

    private async Task<bool> TryPushFeaturesAsync(NodeStateViewModel node, NodeConfiguration config)
    {
        var key = node.Key;

        if (node.IsDisconnected)
        {
            _errorMessage = $"Cannot update features for {node.PortName}: node is disconnected.";
            return false;
        }

        if (!Store.TryGetPortName(key, out var portName) || string.IsNullOrWhiteSpace(portName))
        {
            _errorMessage = $"Cannot update features for {node.Mac ?? node.PortName}: port not found.";
            return false;
        }

        var json = JsonSerializer.Serialize(new
        {
            cmd = "set_features",
            clock_leader = config.ClockLeader,
            imu_host = config.ImuHost,
        });

        var ack = await TrySendCommandAckAsync(portName, json).ConfigureAwait(false);
        if (ack?.Success != true)
        {
            _errorMessage = $"Failed to update features for {portName}: {ack?.Reason ?? "no response"}.";
            return false;
        }

        try
        {
            await ConfigService.SetConfigurationAsync(config).ConfigureAwait(false);
            Store.MarkFeaturesConfigured(node.Mac ?? key);
            _errorMessage = null;
            return true;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to save feature configuration: {ex.Message}";
            return false;
        }
    }

    private async Task SendCommandAsync(NodeStateViewModel node, string cmd, string? type = null)
    {
        var key = node.Key;

        if (!_cooldownKeys.TryAdd(key, 0))
        {
            return;
        }

        try
        {
            if (node.IsDisconnected)
            {
                _errorMessage = $"Cannot send {cmd} to {node.PortName}: node is disconnected.";
                return;
            }

            if (!Store.TryGetPortName(key, out var portName) || string.IsNullOrWhiteSpace(portName))
            {
                _errorMessage = $"Cannot send {cmd} to {node.Mac ?? node.PortName}: port not found.";
                return;
            }

            var json = type is null
                ? $"{{\"cmd\":\"{cmd}\"}}"
                : $"{{\"cmd\":\"{cmd}\",\"type\":\"{type}\"}}";

            var ack = await TrySendCommandAckAsync(portName, json).ConfigureAwait(false);
            if (ack?.Success != true)
            {
                _errorMessage = $"Command {cmd} failed on {portName}: {ack?.Reason ?? "no response"}.";
            }
        }
        finally
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(2000).ConfigureAwait(false);
                _cooldownKeys.TryRemove(key, out _);
                await InvokeAsync(() =>
                {
                    _errorMessage = null;
                    StateHasChanged();
                }).ConfigureAwait(false);
            });
        }
    }

    private Task SendSyncTest(NodeStateViewModel node)
    {
        return SendCommandAsync(node, "diag_test", "sync");
    }

    private Task SendRfScan(NodeStateViewModel node)
    {
        return SendCommandAsync(node, "diag_test", "rf");
    }

    private Task SendSyncTestToAll() => SendDiagTestToAll("sync");

    private Task SendRfTestToAll() => SendDiagTestToAll("rf");

    private async Task SendDiagTestToAll(string type)
    {
        var failed = new List<string>();

        // For the sync diagnostic, push the latest saved (or default follower) roles
        // first so every node actually attaches the sync ISR before entering the test.
        if (type == "sync")
        {
            foreach (var mac in Store.GetConnectedMacs())
            {
                if (!Store.TryGetPortName(mac, out var portName) || string.IsNullOrWhiteSpace(portName))
                {
                    failed.Add(mac);
                    continue;
                }

                if (!ConfigService.TryGetConfiguration(mac, out var configuration) || configuration is null)
                {
                    configuration = new NodeConfiguration { Mac = mac };
                }

                var clockLeader = configuration.ClockLeader ?? false;

                var setFeaturesJson = JsonSerializer.Serialize(new
                {
                    cmd = "set_features",
                    clock_leader = clockLeader,
                    imu_host = configuration.ImuHost,
                });

                var featuresAck = await TrySendCommandAckAsync(portName, setFeaturesJson).ConfigureAwait(false);
                if (featuresAck?.Success != true)
                {
                    failed.Add($"set_features on {portName} ({featuresAck?.Reason ?? "no response"})");
                    continue;
                }

                Store.MarkFeaturesConfigured(mac);
            }
        }

        var json = $"{{\"cmd\":\"diag_test\",\"type\":\"{type}\"}}";

        foreach (var mac in Store.GetConnectedMacs())
        {
            if (!Store.TryGetPortName(mac, out var portName) || string.IsNullOrWhiteSpace(portName))
            {
                failed.Add(mac);
                continue;
            }

            var ack = await TrySendCommandAckAsync(portName, json).ConfigureAwait(false);
            if (ack?.Success != true)
            {
                failed.Add($"{portName} ({ack?.Reason ?? "no response"})");
            }
        }

        _errorMessage = failed.Count > 0
            ? $"Failed to send {type} test to {string.Join(", ", failed)}"
            : null;

        await InvokeAsync(StateHasChanged).ConfigureAwait(false);
    }

    private void OpenRfModal(NodeStateViewModel node)
    {
        _selectedNode = node;
        _manualChannel = node.RfScan.Count > 0
            ? node.RfScan.Values.OrderByDescending(r => r.Packets).First().Channel
            : 6;
    }

    private void CloseRfModal()
    {
        _selectedNode = null;
    }

    private void ShowAggregateModal()
    {
        _showAggregate = true;
        _lockBw = 20;

        if (Store.LatestRecommendation is not null)
        {
            _lockChannel = Store.LatestRecommendation.Channel;
            _lockBw = 20;
            UpdateLockMac();
            var recommendation = Store.LatestRecommendation.Mac;
            if (!string.IsNullOrWhiteSpace(recommendation) && !_lockMacs.Contains(recommendation))
            {
                _lockMacs.Add(recommendation);
            }
        }
        else
        {
            _lockChannel = 6;
            _lockMacs.Clear();
        }
    }

    private void UpdateLockMac()
    {
        SelectTopMacs();
    }

    private void ToggleLockMac(string? mac, ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(mac))
        {
            return;
        }

        if (e.Value is true)
        {
            if (!_lockMacs.Contains(mac))
            {
                _lockMacs.Add(mac);
            }
        }
        else
        {
            _lockMacs.Remove(mac);
        }
    }

    private void SelectTopMacs()
    {
        if (Store.CombinedRfScan.TryGetValue(_lockChannel, out var selectedChannel) && selectedChannel is not null)
        {
            _lockMacs = selectedChannel.TopMacs.Values
                .OrderByDescending(m => m.Packets)
                .ThenByDescending(m => m.RssiAvg)
                .Take(3)
                .Select(m => m.Mac)
                .Where(m => !string.IsNullOrWhiteSpace(m))
                .ToList()!;
        }
        else
        {
            _lockMacs.Clear();
        }
    }

    private async Task LockAndStream()
    {
        if (_lockChannel < 1 || _lockChannel > 13)
        {
            _errorMessage = "Invalid channel.";
            return;
        }

        if (_lockMacs.Count == 0)
        {
            _errorMessage = "Select at least one target MAC.";
            return;
        }

        try
        {
            await Store.BroadcastLockAndStreamAsync(_lockChannel, _lockBw, _lockMacs).ConfigureAwait(false);
            _showAggregate = false;
            _errorMessage = null;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lock & Stream failed: {ex.Message}";
        }
    }

    private void CloseAggregateModal()
    {
        _showAggregate = false;
    }

    private async Task StartDistributedRfScan()
    {
        _errorMessage = null;

        var macs = Store.GetConnectedMacs();
        if (macs.Count == 0)
        {
            _errorMessage = "No connected nodes available for a distributed RF sweep.";
            return;
        }

        try
        {
            await Store.StartDistributedSweepAsync(macs, _sweepDwellMs, !_accumulateSweep).ConfigureAwait(false);
            _errorMessage = null;
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "Distributed RF sweep was cancelled.";
        }
    }

    private async Task SendSetRf()
    {
        var node = _selectedNode;
        if (node is null)
        {
            return;
        }

        var key = node.Key;

        if (!_cooldownKeys.TryAdd(key, 0))
        {
            return;
        }

        try
        {
            if (node.IsDisconnected)
            {
                _errorMessage = $"Cannot send set_rf to {node.PortName}: node is disconnected.";
                return;
            }

            if (!Store.TryGetPortName(key, out var portName) || string.IsNullOrWhiteSpace(portName))
            {
                _errorMessage = $"Cannot send set_rf to {node.Mac ?? node.PortName}: port not found.";
                return;
            }

            var json = JsonSerializer.Serialize(new { cmd = "set_rf", ch = _manualChannel });

            if (!PortManager.TrySendCommand(portName, json))
            {
                _errorMessage = $"Failed to send set_rf to {portName}: channel is closed.";
                return;
            }

            _selectedNode = null;
        }
        finally
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(2000).ConfigureAwait(false);
                _cooldownKeys.TryRemove(key, out _);
                await InvokeAsync(() =>
                {
                    _errorMessage = null;
                    StateHasChanged();
                }).ConfigureAwait(false);
            });
        }
    }

