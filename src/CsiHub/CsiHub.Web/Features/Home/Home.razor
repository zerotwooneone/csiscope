        }

        try
        {
            if (node.IsDisconnected)
            {
                _errorMessage = $"Cannot send set_rf to {node.PortName}: node is disconnected.";
                return;
            }

            if (!Store.TryGetPortName(key, out var portName) || string.IsNullOrWhiteSpace(portName))
            {
                _errorMessage = $"Cannot send set_rf to {node.Mac ?? node.PortName}: port not found.";
                return;
