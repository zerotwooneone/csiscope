    private static string GetConvergenceClass(BaselineDiagnostic diag)
    {
        return diag.IsConverged ? "bg-success" : "bg-warning text-dark";
    }

    private static string GetWorstDropRateClass(IEnumerable<BaselineDiagnostic> group)
    {
        var worst = group.Max(d => d.DropRate);
        return worst switch
        {
            >= 0.10 => "bg-danger",
            >= 0.05 => "bg-warning text-dark",
            _ => "bg-success"
        };
    }

    private static double GetOpacity(BaselineDiagnostic diag)
    {
        const double FadeSeconds = 30.0;
        const double MinOpacity = 0.2;

        if (!diag.LastSeen.HasValue)
        {
            return MinOpacity;
        }

        var seconds = (DateTimeOffset.UtcNow - diag.LastSeen.Value).TotalSeconds;
        return Math.Clamp(1.0 - seconds / FadeSeconds, MinOpacity, 1.0);
    }

    private static string GetLastSeenText(BaselineDiagnostic diag)
    {
        if (!diag.LastSeen.HasValue)
        {
            return "unknown";
        }

        var seconds = (DateTimeOffset.UtcNow - diag.LastSeen.Value).TotalSeconds;
        return $"{seconds:F0}s ago";
    }

    private static string FormatMac(ulong mac)
    {
        return $"{(mac >> 40) & 0xFF:X2}:{(mac >> 32) & 0xFF:X2}:{(mac >> 24) & 0xFF:X2}:{(mac >> 16) & 0xFF:X2}:{(mac >> 8) & 0xFF:X2}:{mac & 0xFF:X2}";
    }

    private IReadOnlyList<BaselineDiagnostic> GetBaselineDiagnostics()
    {
        var list = new List<BaselineDiagnostic>(Dsp.Baselines.Count);

        foreach (var (key, baseline) in Dsp.Baselines)
        {
            if (!baseline.IsInitialized)
            {
                continue;
            }

            list.Add(new BaselineDiagnostic(
                key.NodeMac,
                key.SrcMac,
                baseline.TotalFrames,
                baseline.Bandwidth,
                baseline.MeanIq,
                baseline.PercentileVariance,
                baseline.IsConverged,
                0,
                0.0,
                baseline.LastSeen));
        }

        var enriched = new List<BaselineDiagnostic>(list.Count);
        foreach (var group in list.GroupBy(d => d.SrcMac))
        {
            var leaderCount = group.Max(d => d.FrameCount);
            foreach (var diag in group)
            {
                var delta = leaderCount - diag.FrameCount;
                enriched.Add(diag with
                {
                    FrameDelta = delta,
                    DropRate = leaderCount == 0 ? 0.0 : (double)delta / leaderCount,
                });
            }
        }

        return enriched;
    }

    private sealed record BaselineDiagnostic(
        string NodeMac,
        ulong SrcMac,
        long FrameCount,
        int Bandwidth,
        double MeanIq,
        double PercentileVariance,
        bool IsConverged,
        long FrameDelta = 0,
        double DropRate = 0.0,
        DateTimeOffset? LastSeen = null);

