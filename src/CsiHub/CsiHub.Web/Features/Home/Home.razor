@page "/"
@rendermode InteractiveServer
@using CsiHub.Features.Home.Services
@using CsiHub.Ingestion
@using Microsoft.JSInterop
@using System.Linq
@using System.Text.Json
@inject CsiNodeStateStore Store
@inject CsiNodePortManager PortManager
@inject CsiNodeConfigurationService ConfigService
@inject CsiDspBackgroundService Dsp
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Low-Level View</PageTitle>

<h3>Low-Level View</h3>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @_errorMessage
        <button type="button" class="btn-close" aria-label="Close" @onclick="() => _errorMessage = null"></button>
    </div>
}

<div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
    <div class="d-flex gap-2 align-items-center">
        <label class="form-label mb-0">Scan depth</label>
        <select class="form-select form-select-sm" style="width: 11rem;" @bind="_sweepDwellMs">
            <option value="250">Quick (250 ms)</option>
            <option value="1000">Standard (1000 ms)</option>
            <option value="3000">Deep (3000 ms)</option>
        </select>
    </div>
    <div class="form-check form-check-inline mb-0">
        <input class="form-check-input" type="checkbox" id="accumulateSweep" @bind="_accumulateSweep">
        <label class="form-check-label" for="accumulateSweep">Accumulate across passes</label>
    </div>
    <button class="btn btn-primary" type="button" disabled="@Store.IsDistributedSweepActive" @onclick="StartDistributedRfScan">
        @(Store.IsDistributedSweepActive ? "Distributed RF Sweep Running..." : "Run Distributed RF Sweep")
    </button>
    <button class="btn btn-outline-primary" type="button" @onclick="ShowAggregateModal">View Aggregate RF Scan</button>
    @if (Store.IsDistributedSweepActive)
    {
        <button class="btn btn-outline-danger" type="button" @onclick="Store.StopDistributedSweep">Cancel Sweep</button>
    }
</div>

<table class="table">
    <thead>
        <tr>
            <th>COM Port</th>
            <th>MAC Address</th>
            <th>Connection Status</th>
            <th>Uptime</th>
            <th>Last Seen</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var node in Store.Nodes.Values)
        {
            <tr class="@(node.IsDisconnected ? "table-danger" : "")">
                <td>@node.PortName</td>
                <td>@(node.Mac ?? "-")</td>
                <td>
                    @node.State
                    @if (node.ActiveErrors.Count > 0)
                    {
                        <span class="badge bg-danger ms-2" data-bs-toggle="tooltip" data-bs-placement="top" title="@GetErrorsTooltip(node)">!</span>
                    }
                </td>
                <td>@(node.Uptime is not null ? TimeSpan.FromSeconds(node.Uptime.Value).ToString("hh\\:mm\\:ss") : "-")</td>
                <td>@(node.LastSeen is not null ? (DateTimeOffset.UtcNow - node.LastSeen.Value).ToString("hh\\:mm\\:ss") + " ago" : "-")</td>
                <td>
                    <div class="d-inline-flex flex-wrap gap-1">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Actions
                            </button>
                            <ul class="dropdown-menu">
                                <li><button class="dropdown-item" type="button" @onclick="() => SendSyncTest(node)">Sync Test</button></li>
                                <li><button class="dropdown-item" type="button" @onclick="() => SendRfScan(node)">Run RF Scan</button></li>
                                <li><button class="dropdown-item" type="button" @onclick="() => OpenRfModal(node)">RF Channel Override</button></li>
                                <li><button class="dropdown-item" type="button" @onclick="() => SendReboot(node)">Reboot</button></li>
                            </ul>
                        </div>

                        @{
                            var safeId = GetSafeId(node);
                        }

                        <div class="dropdown" data-bs-auto-close="outside">
                            <button class="btn btn-sm btn-info dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Hardware Features
                            </button>
                            <ul class="dropdown-menu p-3" style="min-width: 14rem;">
                                <li class="mb-2">
                                    <div class="form-check form-switch" @onclick:stopPropagation="true">
                                        <input class="form-check-input" type="checkbox" role="switch" id="clock-@safeId" checked="@IsClockLeader(node)" @onchange="(e) => ToggleClockLeader(node, e)">
                                        <label class="form-check-label" for="clock-@safeId">Clock Leader</label>
                                    </div>
                                    @if (node.ActiveErrors.ContainsKey("clock_leader"))
                                    {
                                        <button class="btn btn-link text-danger p-0" type="button" @onclick="() => RetryClockLeader(node)">
                                            <span class="me-1">↻</span>Retry
                                        </button>
                                    }
                                </li>
                                <li class="mb-2">
                                    <div class="form-check form-switch" @onclick:stopPropagation="true">
                                        <input class="form-check-input" type="checkbox" role="switch" id="imu-@safeId" checked="@IsImuHost(node)" @onchange="(e) => ToggleImuHost(node, e)">
                                        <label class="form-check-label" for="imu-@safeId">IMU Host</label>
                                    </div>
                                    @if (node.ActiveErrors.ContainsKey("imu_host"))
                                    {
                                        <button class="btn btn-link text-danger p-0" type="button" @onclick="() => RetryImuHost(node)">
                                            <span class="me-1">↻</span>Retry
                                        </button>
                                    }
                                </li>
                            </ul>
                        </div>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (_selectedNode is not null)
{
    var safeId = GetSafeId(_selectedNode);
    var maxPackets = _selectedNode.RfScan.Count > 0 ? _selectedNode.RfScan.Values.Max(r => r.Packets) : 0.0;

    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" @onclick="CloseRfModal">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">RF Scan - @(_selectedNode.Mac ?? _selectedNode.PortName)</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseRfModal"></button>
                </div>
                <div class="modal-body">
                    @if (_selectedNode.RfScan.Count > 0)
                    {
                        <h6 class="mb-3">Channel Congestion</h6>
                        @foreach (var channel in _selectedNode.RfScan.Values.OrderBy(r => r.Channel))
                        {
                            <div class="d-flex align-items-center mb-2">
                                <div class="text-end me-2" style="width: 3rem;">Ch @channel.Channel</div>
                                <div class="progress flex-grow-1" style="height: 1.5rem;">
                                    <div class="progress-bar" role="progressbar" style="width: @(GetRfBarWidth(channel, maxPackets).ToString("F1"))%" title="RSSI min/max/avg: @channel.RssiMin / @channel.RssiMax / @channel.RssiAvg dBm, @channel.Errors errors">
                                    </div>
                                </div>
                                <div class="ms-2 text-muted" style="width: 7rem;">@channel.Packets pkts</div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No RF scan data available. Click <strong>Run RF Scan</strong> to collect channel metrics.</p>
                    }

                    <hr />

                    <div class="row g-3 align-items-center">
                        <div class="col-auto">
                            <label for="rf-channel-@safeId" class="col-form-label">Manual channel override</label>
                        </div>
                        <div class="col-auto">
                            <select id="rf-channel-@safeId" class="form-select" @bind="_manualChannel">
                                @for (int ch = 1; ch <= 13; ch++)
                                {
                                    <option value="@ch">@ch</option>
                                }
                            </select>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-primary" type="button" @onclick="SendSetRf">Set Channel</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" @onclick="CloseRfModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_showAggregate)
{
    var maxPackets = Store.CombinedRfScan.Count > 0 ? Store.CombinedRfScan.Values.Max(r => r.Packets) : 0.0;

    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" @onclick="CloseAggregateModal">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Aggregate RF Scan (1-13)</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseAggregateModal"></button>
                </div>
                <div class="modal-body">
                    @if (Store.LatestRecommendation is not null)
                    {
                        <div class="alert alert-info">
                            <strong>Recommendation:</strong> @Store.LatestRecommendation.Reason<br />
                            <small>Score: @Store.LatestRecommendation.Score.ToString("F2")</small>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary">Run a distributed RF sweep to generate a channel / MAC recommendation.</div>
                    }

                    @if (Store.CombinedRfScan.Count > 0)
                    {
                        <h6 class="mb-3">Combined Channel Congestion</h6>
                        @foreach (var channel in Store.CombinedRfScan.Values.OrderBy(r => r.Channel))
                        {
                            <div class="d-flex align-items-center mb-2">
                                <div class="text-end me-2" style="width: 3rem;">Ch @channel.Channel</div>
                                <div class="progress flex-grow-1" style="height: 1.5rem;">
                                    <div class="progress-bar" role="progressbar" style="width: @(GetRfBarWidth(channel, maxPackets).ToString("F1"))%" title="RSSI min/max/avg: @channel.RssiMin / @channel.RssiMax / @channel.RssiAvg dBm, @channel.Errors errors, @channel.SampleCount nodes">
                                    </div>
                                </div>
                                <div class="ms-2 text-muted" style="width: 7rem;">@channel.Packets pkts</div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No aggregate RF scan data available. Run a distributed RF sweep to collect a complete 1-13 channel map.</p>
                    }

                    <hr />

                    <h6 class="mb-3">Lock & Stream</h6>
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">Channel</label>
                            <select class="form-select" @bind="LockChannel">
                                @for (int ch = 1; ch <= 13; ch++)
                                {
                                    <option value="@ch">@ch</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Target MACs</label>
                            <div class="border rounded p-2" style="max-height: 10rem; overflow-y: auto;">
                                @if (Store.CombinedRfScan.TryGetValue(_lockChannel, out var selectedChannel) && selectedChannel is not null)
                                {
                                    @foreach (var mac in selectedChannel.TopMacs.Values.OrderByDescending(m => m.Packets).ThenByDescending(m => m.RssiAvg))
                                    {
                                        var macId = mac.Mac?.Replace(":", "-");
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="mac-@macId" checked="@_lockMacs.Contains(mac.Mac!)" @onchange="(e) => ToggleLockMac(mac.Mac, e)">
                                            <label class="form-check-label" for="mac-@macId" style="font-size: 0.875rem;">@mac.Mac (@mac.Packets pkts, @mac.RssiAvg.ToString("F1") dBm)</label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted mb-0">No MACs available for this channel.</p>
                                }
                            </div>
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button class="btn btn-outline-secondary w-100" type="button" @onclick="SelectTopMacs">Top 3</button>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">BW (MHz)</label>
                            <input type="number" class="form-control" @bind="_lockBw" min="20" max="40" step="20" />
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-success w-100" type="button" @onclick="LockAndStream">Lock & Stream</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" @onclick="CloseAggregateModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<h4 class="mt-4">Baseline Convergence</h4>
@if (Dsp.Baselines.Count == 0)
{
    <p class="text-muted">No baselines have been established yet. Run Lock & Stream to start learning.</p>
}
else
{
    @foreach (var group in GetBaselineDiagnostics()
        .GroupBy(d => d.SrcMac)
        .Where(g => g.Sum(d => d.FrameCount) >= 50)
        .OrderByDescending(g => g.Sum(d => d.FrameCount)))
    {
        <div class="card mb-3">
            <div class="card-header">
                Target: @FormatMac(group.Key)
            </div>
            <div class="card-body">
                <div class="row text-center">
                    @foreach (var diag in group.OrderByDescending(d => d.FrameCount))
                    {
                        <div class="col-md-4">
                            <h6>@diag.NodeMac</h6>
                            <div>@diag.FrameCount frames</div>
                            <div>BW: @diag.Bandwidth MHz</div>
                            <div>Mean I/Q: @diag.MeanIq.ToString("F2")</div>
                            <div>Max Var: @diag.MaxVariance.ToString("F4")</div>
                            <span class="badge @GetConvergenceClass(diag)">
                                @(diag.IsConverged ? "Converged" : "Learning")
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private PeriodicTimer? _timer;
    private string? _errorMessage;
    private NodeStateViewModel? _selectedNode;
    private bool _showAggregate;
    private int _manualChannel = 6;
    private int _lockChannel = 6;
    private int _lockBw = 20;
    private List<string> _lockMacs = new();
    private int _sweepDwellMs = 250;
    private bool _accumulateSweep;
    private readonly ConcurrentDictionary<string, byte> _cooldownKeys = new();
    private readonly ConcurrentDictionary<string, NodeConfiguration> _localConfigurations = new();

    private int LockChannel
    {
        get => _lockChannel;
        set
        {
            if (_lockChannel != value)
            {
                _lockChannel = value;
                UpdateLockMac();
            }
        }
    }

    private async Task UpdateLoop()
    {
        if (_timer is null)
        {
            return;
        }

        while (await _timer.WaitForNextTickAsync().ConfigureAwait(false))
        {
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _timer is null)
        {
            _timer = new PeriodicTimer(TimeSpan.FromMilliseconds(333));
            _ = UpdateLoop();
        }

        await JS.InvokeVoidAsync("initTooltips");
    }

    private bool IsDisabled(string key)
    {
        return _cooldownKeys.ContainsKey(key);
    }

    private NodeConfiguration GetConfig(NodeStateViewModel node)
    {
        return _localConfigurations.GetOrAdd(node.Key, _ =>
        {
            var mac = node.Mac ?? node.Key;
            if (ConfigService.TryGetConfiguration(mac, out var existing) && existing is not null)
            {
                return new NodeConfiguration
                {
                    Mac = existing.Mac,
                    ClockLeader = existing.ClockLeader,
                    ImuHost = existing.ImuHost,
                };
            }

            return new NodeConfiguration { Mac = mac };
        });
    }

    private string GetSafeId(NodeStateViewModel node)
    {
        var mac = node.Mac ?? node.PortName ?? "unknown";
        return System.Text.RegularExpressions.Regex.Replace(mac, @"[^a-zA-Z0-9]", "-");
    }

    private bool IsClockLeader(NodeStateViewModel node) => GetConfig(node).ClockLeader;
    private bool IsImuHost(NodeStateViewModel node) => GetConfig(node).ImuHost;

    private async Task ToggleClockLeader(NodeStateViewModel node, ChangeEventArgs e)
    {
        var config = GetConfig(node);
        var newValue = e.Value is bool b && b;
        var previous = config.ClockLeader;
        config.ClockLeader = newValue;

        if (!await TryPushFeaturesAsync(node, config))
        {
            config.ClockLeader = previous;
        }
    }

    private async Task ToggleImuHost(NodeStateViewModel node, ChangeEventArgs e)
    {
        var config = GetConfig(node);
        var newValue = e.Value is bool b && b;
        var previous = config.ImuHost;
        config.ImuHost = newValue;

        if (!await TryPushFeaturesAsync(node, config))
        {
            config.ImuHost = previous;
        }
    }

    private async Task<bool> TryPushFeaturesAsync(NodeStateViewModel node, NodeConfiguration config)
    {
        var key = node.Key;

        if (node.IsDisconnected)
        {
            _errorMessage = $"Cannot update features for {node.PortName}: node is disconnected.";
            return false;
        }

        if (!Store.TryGetPortName(key, out var portName) || string.IsNullOrWhiteSpace(portName))
        {
            _errorMessage = $"Cannot update features for {node.Mac ?? node.PortName}: port not found.";
            return false;
        }

        var json = JsonSerializer.Serialize(new
        {
            cmd = "set_features",
            clock_leader = config.ClockLeader,
            imu_host = config.ImuHost,
        });

        if (!PortManager.TrySendCommand(portName, json))
        {
            _errorMessage = $"Failed to update features for {portName}: channel is closed.";
            return false;
        }

        try
        {
            await ConfigService.SetConfigurationAsync(config).ConfigureAwait(false);
            _errorMessage = null;
            return true;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to save feature configuration: {ex.Message}";
            return false;
        }
    }

    private async Task SendCommandAsync(NodeStateViewModel node, string cmd, string? type = null)
    {
        var key = node.Key;

        if (!_cooldownKeys.TryAdd(key, 0))
        {
            return;
        }

        try
        {
            if (node.IsDisconnected)
            {
                _errorMessage = $"Cannot send {cmd} to {node.PortName}: node is disconnected.";
                return;
            }

            if (!Store.TryGetPortName(key, out var portName) || string.IsNullOrWhiteSpace(portName))
            {
                _errorMessage = $"Cannot send {cmd} to {node.Mac ?? node.PortName}: port not found.";
                return;
            }

            var json = type is null
                ? $"{{\"cmd\":\"{cmd}\"}}"
                : $"{{\"cmd\":\"{cmd}\",\"type\":\"{type}\"}}";

            if (!PortManager.TrySendCommand(portName, json))
            {
                _errorMessage = $"Failed to send {cmd} to {portName}: channel is closed.";
            }
        }
        finally
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(2000).ConfigureAwait(false);
                _cooldownKeys.TryRemove(key, out _);
                await InvokeAsync(() =>
                {
                    _errorMessage = null;
                    StateHasChanged();
                }).ConfigureAwait(false);
            });
        }
    }

    private Task SendSyncTest(NodeStateViewModel node)
    {
        return SendCommandAsync(node, "diag_test", "sync");
    }

    private Task SendRfScan(NodeStateViewModel node)
    {
        return SendCommandAsync(node, "diag_test", "rf");
    }

    private void OpenRfModal(NodeStateViewModel node)
    {
        _selectedNode = node;
        _manualChannel = node.RfScan.Count > 0
            ? node.RfScan.Values.OrderByDescending(r => r.Packets).First().Channel
            : 6;
    }

    private void CloseRfModal()
    {
        _selectedNode = null;
    }

    private void ShowAggregateModal()
    {
        _showAggregate = true;
        _lockBw = 20;

        if (Store.LatestRecommendation is not null)
        {
            _lockChannel = Store.LatestRecommendation.Channel;
            _lockBw = 20;
            UpdateLockMac();
            var recommendation = Store.LatestRecommendation.Mac;
            if (!string.IsNullOrWhiteSpace(recommendation) && !_lockMacs.Contains(recommendation))
            {
                _lockMacs.Add(recommendation);
            }
        }
        else
        {
            _lockChannel = 6;
            _lockMacs.Clear();
        }
    }

    private void UpdateLockMac()
    {
        SelectTopMacs();
    }

    private void ToggleLockMac(string? mac, ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(mac))
        {
            return;
        }

        if (e.Value is true)
        {
            if (!_lockMacs.Contains(mac))
            {
                _lockMacs.Add(mac);
            }
        }
        else
        {
            _lockMacs.Remove(mac);
        }
    }

    private void SelectTopMacs()
    {
        if (Store.CombinedRfScan.TryGetValue(_lockChannel, out var selectedChannel) && selectedChannel is not null)
        {
            _lockMacs = selectedChannel.TopMacs.Values
                .OrderByDescending(m => m.Packets)
                .ThenByDescending(m => m.RssiAvg)
                .Take(3)
                .Select(m => m.Mac)
                .Where(m => !string.IsNullOrWhiteSpace(m))
                .ToList()!;
        }
        else
        {
            _lockMacs.Clear();
        }
    }

    private async Task LockAndStream()
    {
        if (_lockChannel < 1 || _lockChannel > 13)
        {
            _errorMessage = "Invalid channel.";
            return;
        }

        if (_lockMacs.Count == 0)
        {
            _errorMessage = "Select at least one target MAC.";
            return;
        }

        try
        {
            await Store.BroadcastLockAndStreamAsync(_lockChannel, _lockBw, _lockMacs).ConfigureAwait(false);
            _showAggregate = false;
            _errorMessage = null;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lock & Stream failed: {ex.Message}";
        }
    }

    private void CloseAggregateModal()
    {
        _showAggregate = false;
    }

    private async Task StartDistributedRfScan()
    {
        _errorMessage = null;

        var macs = Store.GetConnectedMacs();
        if (macs.Count == 0)
        {
            _errorMessage = "No connected nodes available for a distributed RF sweep.";
            return;
        }

        try
        {
            await Store.StartDistributedSweepAsync(macs, _sweepDwellMs, !_accumulateSweep).ConfigureAwait(false);
            _errorMessage = null;
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "Distributed RF sweep was cancelled.";
        }
    }

    private async Task SendSetRf()
    {
        var node = _selectedNode;
        if (node is null)
        {
            return;
        }

        var key = node.Key;

        if (!_cooldownKeys.TryAdd(key, 0))
        {
            return;
        }

        try
        {
            if (node.IsDisconnected)
            {
                _errorMessage = $"Cannot send set_rf to {node.PortName}: node is disconnected.";
                return;
            }

            if (!Store.TryGetPortName(key, out var portName) || string.IsNullOrWhiteSpace(portName))
            {
                _errorMessage = $"Cannot send set_rf to {node.Mac ?? node.PortName}: port not found.";
                return;
            }

            var json = JsonSerializer.Serialize(new { cmd = "set_rf", ch = _manualChannel });

            if (!PortManager.TrySendCommand(portName, json))
            {
                _errorMessage = $"Failed to send set_rf to {portName}: channel is closed.";
                return;
            }

            _selectedNode = null;
        }
        finally
        {
            _ = Task.Run(async () =>
            {
                await Task.Delay(2000).ConfigureAwait(false);
                _cooldownKeys.TryRemove(key, out _);
                await InvokeAsync(() =>
                {
                    _errorMessage = null;
                    StateHasChanged();
                }).ConfigureAwait(false);
            });
        }
    }

    private Task SendReboot(NodeStateViewModel node)
    {
        return SendCommandAsync(node, "reboot");
    }

    private static string GetErrorsTooltip(NodeStateViewModel node)
        => string.Join("; ", node.ActiveErrors.Select(e => $"{e.Key}: {e.Value}"));

    private static double GetRfBarWidth(RfChannelMetrics metrics, double maxPackets)
    {
        if (maxPackets <= 0 || metrics.Packets <= 0)
        {
            return 0.0;
        }

        return Math.Min(100.0, metrics.Packets * 100.0 / maxPackets);
    }

    private static double GetRfBarWidth(RfChannelAggregate aggregate, double maxPackets)
    {
        if (maxPackets <= 0 || aggregate.Packets <= 0)
        {
            return 0.0;
        }

        return Math.Min(100.0, aggregate.Packets * 100.0 / maxPackets);
    }

    private Task RetryClockLeader(NodeStateViewModel node) => RetryFeatureAsync(node, "clock_leader");

    private Task RetryImuHost(NodeStateViewModel node) => RetryFeatureAsync(node, "imu_host");

    private async Task RetryFeatureAsync(NodeStateViewModel node, string feature)
    {
        _errorMessage = null;
        await Store.RetryFeatureAsync(node, feature).ConfigureAwait(false);
    }

    private static string GetConvergenceClass(BaselineDiagnostic diag)
    {
        return diag.IsConverged ? "bg-success" : "bg-warning text-dark";
    }

    private static string FormatMac(ulong mac)
    {
        return $"{(mac >> 40) & 0xFF:X2}:{(mac >> 32) & 0xFF:X2}:{(mac >> 24) & 0xFF:X2}:{(mac >> 16) & 0xFF:X2}:{(mac >> 8) & 0xFF:X2}:{mac & 0xFF:X2}";
    }

    private IReadOnlyList<BaselineDiagnostic> GetBaselineDiagnostics()
    {
        var list = new List<BaselineDiagnostic>(Dsp.Baselines.Count);

        foreach (var (key, baseline) in Dsp.Baselines)
        {
            if (!baseline.IsInitialized)
            {
                continue;
            }

            var mean = baseline.Mean;
            var variance = baseline.Variance;

            double meanIq = 0.0;
            double maxVariance = 0.0;
            for (int i = 0; i < mean.Length; i++)
            {
                meanIq += mean[i];
                if (variance[i] > maxVariance)
                {
                    maxVariance = variance[i];
                }
            }

            if (mean.Length > 0)
            {
                meanIq /= mean.Length;
            }

            list.Add(new BaselineDiagnostic(
                key.NodeMac,
                key.SrcMac,
                baseline.TotalFrames,
                baseline.Bandwidth,
                meanIq,
                maxVariance,
                baseline.IsConverged));
        }

        return list;
    }

    private sealed record BaselineDiagnostic(
        string NodeMac,
        ulong SrcMac,
        long FrameCount,
        int Bandwidth,
        double MeanIq,
        double MaxVariance,
        bool IsConverged);

    public ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        return ValueTask.CompletedTask;
    }
