    }

    private async Task StartDistributedRfScan()
    {
        _errorMessage = null;

        var macs = Store.GetConnectedMacs();
        if (macs.Count == 0)
        {
            _errorMessage = "No connected nodes available for a distributed RF sweep.";
            return;
        }

        try
        {
            await Store.StartDistributedSweepAsync(macs, _sweepDwellMs, !_accumulateSweep).ConfigureAwait(false);
            _errorMessage = null;
        }
        catch (OperationCanceledException)
        {
            _errorMessage = "Distributed RF sweep was cancelled.";
        }
    }

