            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    // ---- Geometry drag-and-drop ----

    private enum GeometrySlot { Origin, XArm, YArm }

    private sealed record GeometrySlotInfo(GeometrySlot Id, string Label, int Left, int Top);

    // Board coordinates are the center of each 64px slot circle inside the
    // 160x160 board; CSS translate(-50%,-50%) centers the slot on the point.
    // Layout mirrors the AoA canvas: origin bottom-left, +X right, +Y up.
    private static readonly GeometrySlotInfo[] GeometrySlots =
    {
        new(GeometrySlot.Origin, "Origin", 32, 128),
        new(GeometrySlot.XArm, "+X", 128, 128),
        new(GeometrySlot.YArm, "+Y", 32, 32),
    };

    private string? _draggedMac;
    private GeometrySlot? _dragOverSlot;
    private bool _dragOverTray;

    private string? GetSlotMac(GeometrySlot slot) => slot switch
    {
        GeometrySlot.Origin => _geometry.OriginMac,
        GeometrySlot.XArm => _geometry.XArmMac,
        GeometrySlot.YArm => _geometry.YArmMac,
        _ => null,
    };

    private void SetSlotMac(GeometrySlot slot, string? mac)
    {
        switch (slot)
        {
            case GeometrySlot.Origin: _geometry.OriginMac = mac; break;
            case GeometrySlot.XArm: _geometry.XArmMac = mac; break;
            case GeometrySlot.YArm: _geometry.YArmMac = mac; break;
        }
    }

    private GeometrySlot? FindSlot(string mac)
    {
        foreach (var slot in GeometrySlots)
        {
            if (string.Equals(GetSlotMac(slot.Id), mac, StringComparison.OrdinalIgnoreCase))
            {
                return slot.Id;
            }
        }

        return null;
    }

    private IEnumerable<string> GetUnassignedMacs()
    {
        return GetConnectedMacs().Where(m => FindSlot(m) is null);
    }

    private bool IsConnected(string mac)
    {
        return GetConnectedMacs().Contains(mac, StringComparer.OrdinalIgnoreCase);
    }

    private string? GetPortForMac(string mac)
    {
        if (Store.TryGetPortName(mac, out var port) && !string.IsNullOrWhiteSpace(port))
        {
            return port;
        }

        // Saved MACs can differ in case from live MAC keys; fall back to a
        // case-insensitive scan so the chip still shows its COM port.
        return Store.Nodes.Values
            .FirstOrDefault(n => string.Equals(n.Mac, mac, StringComparison.OrdinalIgnoreCase))
            ?.PortName;
    }

    private static string MacLast4(string mac)
    {
        var hex = mac.Replace(":", string.Empty).Replace("-", string.Empty);
        return hex.Length > 4 ? hex[^4..].ToUpperInvariant() : hex.ToUpperInvariant();
    }

    private void OnGeometryDrop(GeometrySlot target)
    {
        if (_draggedMac is null)
        {
            return;
        }

        var source = FindSlot(_draggedMac);
        if (source != target)
        {
            var displaced = GetSlotMac(target);

            // Swap: the target's occupant moves to the dragged node's old slot.
            // When the drag came from the tray there is no old slot, so the
            // displaced node simply becomes unassigned.
            if (source is not null)
            {
                SetSlotMac(source.Value, displaced);
            }

            SetSlotMac(target, _draggedMac);
        }

        OnGeometryDragEnd();
    }

    private void OnTrayDrop()
    {
        if (_draggedMac is not null && FindSlot(_draggedMac) is { } source)
        {
            SetSlotMac(source, null);
        }

        OnGeometryDragEnd();
    }

    private void OnGeometryDragEnd()
    {
        _draggedMac = null;
        _dragOverSlot = null;
        _dragOverTray = false;
    }

    private RenderFragment NodeChip(string mac)
    {
        var port = GetPortForMac(mac);
        var offline = IsConnected(mac) ? null : "geom-chip-off";
        return@<div class="geom-chip @offline"
                   style="background-color:@(mac.ToMacColor())"
                   draggable="true"
                   data-geom-drag="@mac"
                   title="@mac"
                   @ondragstart="() => _draggedMac = mac"
                   @ondragend="OnGeometryDragEnd">
                    <span class="geom-chip-mac">@MacLast4(mac)</span>
                    <span class="geom-chip-port">@(port ?? "?")</span>
                </div>;
    }

    private IEnumerable<TargetPlacement> GetTargetPlacements()
    {
        // MUSIC/EVD returns only an angle. Passive Wi-Fi has no ToF, so
        // the target is always placed on a fixed outer ring to show direction.
        const double Center = 180.0;
        const double TrackRadius = 150.0;

        foreach (var group in GetBaselineDiagnostics()
            .GroupBy(d => d.SrcMac)
            .Where(g => g.Sum(d => d.FrameCount) >= 50))
        {
            if (!Dsp.AoaResults.TryGetValue(group.Key, out var aoa) || !aoa.PeakAngleDegrees.HasValue)
            {
                continue;
            }

            double angleRad = aoa.PeakAngleDegrees.Value * Math.PI / 180.0;
            double x = Center + TrackRadius * Math.Sin(angleRad);
            double y = Center - TrackRadius * Math.Cos(angleRad);

            double p95Variance = group.Max(d => d.PercentileVariance);
            double dotRadius = Math.Clamp(Math.Sqrt(p95Variance) * 60.0, 4.0, 20.0);
            string color = FormatMac(group.Key).ToMacColor();

            yield return new TargetPlacement(
                FormatMac(group.Key),
                x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                dotRadius.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                color);
        }
    }

    private sealed record TargetPlacement(string Mac, string X, string Y, string Radius, string Color);

    // ---- Raw subcarrier phase jitter plot ----

    private static readonly string[] PhasePalette =
        { "#e6194b", "#3cb44b", "#4363d8", "#f58231", "#911eb4", "#42d4f4", "#f032e6", "#bfef45" };

    private static string PhaseColor(int index) => PhasePalette[index % PhasePalette.Length];

    // Maps packet index -> X and phase (-pi..+pi) -> Y inside the 720x220 viewBox.
    // Plot area: x in [34,716], y in [12,208] with 0-phase at the y=110 midline.
    private static string PhasePoints(IReadOnlyList<double> phases)
    {
        const double Left = 34.0, Right = 716.0, MidY = 110.0, HalfAmp = 98.0;
        if (phases.Count == 0)
        {
            return string.Empty;
        }

        var sb = new System.Text.StringBuilder(phases.Count * 10);
        double denom = Math.Max(1, phases.Count - 1);
        for (int i = 0; i < phases.Count; i++)
        {
            double x = Left + (i / denom) * (Right - Left);
            double y = MidY - (phases[i] / Math.PI) * HalfAmp;
            sb.Append(x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))
              .Append(',')
              .Append(y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))
              .Append(' ');
        }

        return sb.ToString();
    }

    private sealed record SyncDiagnosticRow(string Mac, long PulseCount, double LatencyUs, double JitterUs);

    private sealed record RfDiagnosticRow(string Mac, int Channel, double RssiMin, double RssiMax, double RssiAvg, long Packets, long Errors);

    private IReadOnlyList<SyncDiagnosticRow> GetSyncDiagnostics()
    {
        var rows = new List<SyncDiagnosticRow>();

        foreach (var node in Store.Nodes.Values
            .Where(n => n.SyncDiag is not null)
            .OrderBy(n => n.Mac ?? n.Key, StringComparer.OrdinalIgnoreCase))
        {
            rows.Add(new SyncDiagnosticRow(
                node.Mac ?? node.Key,
                node.SyncDiag!.PulseCount,
                node.SyncDiag!.LatencyUs,
                node.SyncDiag!.JitterUs));
        }

        return rows;
    }

    private IReadOnlyList<RfDiagnosticRow> GetRfDiagnostics()
    {
        var rows = new List<RfDiagnosticRow>();

        foreach (var node in Store.Nodes.Values
            .Where(n => n.State == NodeConnectionState.DiagRf || n.RfScan.Count > 0)
            .OrderBy(n => n.Mac ?? n.Key, StringComparer.OrdinalIgnoreCase))
        {
            foreach (var (channel, rf) in node.RfScan.OrderBy(kv => kv.Key))
            {
                rows.Add(new RfDiagnosticRow(
                    node.Mac ?? node.Key,
                    channel,
                    rf.RssiMin,
                    rf.RssiMax,
                    rf.RssiAvg,
                    rf.Packets,
                    rf.Errors));
            }
        }

        return rows;
    }

    public ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        return ValueTask.CompletedTask;
    }
