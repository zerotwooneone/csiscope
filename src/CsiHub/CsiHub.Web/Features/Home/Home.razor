    private IEnumerable<TargetPlacement> GetTargetPlacements()
    {
        // MUSIC/EVD returns only an angle. Passive Wi-Fi has no ToF, so
        // the target is always placed on a fixed outer ring to show direction.
        const double Center = 180.0;
        const double TrackRadius = 150.0;

        foreach (var group in GetBaselineDiagnostics()
            .GroupBy(d => d.SrcMac)
            .Where(g => g.Sum(d => d.FrameCount) >= 50))
        {
            if (!Dsp.AoaResults.TryGetValue(group.Key, out var aoa) || !aoa.PeakAngleDegrees.HasValue)
            {
                continue;
            }

            double angleRad = aoa.PeakAngleDegrees.Value * Math.PI / 180.0;
            double x = Center + TrackRadius * Math.Sin(angleRad);
            double y = Center - TrackRadius * Math.Cos(angleRad);

            double p95Variance = group.Max(d => d.PercentileVariance);
            double dotRadius = Math.Clamp(Math.Sqrt(p95Variance) * 60.0, 4.0, 20.0);
            string color = FormatMac(group.Key).ToMacColor();

            yield return new TargetPlacement(
                FormatMac(group.Key),
                x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                dotRadius.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                color);
        }
    }

    private sealed record TargetPlacement(string Mac, string X, string Y, string Radius, string Color);

    private sealed record SyncDiagnosticRow(string Mac, long PulseCount, double LatencyUs, double JitterUs);

    private sealed record RfDiagnosticRow(string Mac, int Channel, double RssiMin, double RssiMax, double RssiAvg, long Packets, long Errors);

    private IReadOnlyList<SyncDiagnosticRow> GetSyncDiagnostics()
    {
        var rows = new List<SyncDiagnosticRow>();

        foreach (var node in Store.Nodes.Values
            .Where(n => n.SyncDiag is not null)
            .OrderBy(n => n.Mac ?? n.Key, StringComparer.OrdinalIgnoreCase))
        {
            rows.Add(new SyncDiagnosticRow(
                node.Mac ?? node.Key,
                node.SyncDiag!.PulseCount,
                node.SyncDiag!.LatencyUs,
                node.SyncDiag!.JitterUs));
        }

        return rows;
    }

    private IReadOnlyList<RfDiagnosticRow> GetRfDiagnostics()
    {
        var rows = new List<RfDiagnosticRow>();

        foreach (var node in Store.Nodes.Values
            .Where(n => n.State == NodeConnectionState.DiagRf || n.RfScan.Count > 0)
            .OrderBy(n => n.Mac ?? n.Key, StringComparer.OrdinalIgnoreCase))
        {
            foreach (var (channel, rf) in node.RfScan.OrderBy(kv => kv.Key))
            {
                rows.Add(new RfDiagnosticRow(
                    node.Mac ?? node.Key,
                    channel,
                    rf.RssiMin,
                    rf.RssiMax,
                    rf.RssiAvg,
                    rf.Packets,
                    rf.Errors));
            }
        }

        return rows;
    }

